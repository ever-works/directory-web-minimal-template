---
/**
 * Tag Page — every item with one tag (server-rendered, crawlable), with in-page search, category filters, sort and
 * view switching. Alias URLs canonicalize to `/tag/<id>`.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContent } from '../../lib/content';
import { getSite } from '../../lib/site';
import { exampleNames, scopedTaxonomy, sortedCards } from '../../lib/listing';
import { breadcrumbJsonLd, collectionPageJsonLd } from '../../lib/structured-data';
import Breadcrumbs from '@ever-works/ui/astro/Breadcrumbs.astro';
import DirectoryBrowser from '@ever-works/ui/astro/DirectoryBrowser.astro';
import { itemHasTag, uniquePathAliases } from '../../lib/taxonomy';

export async function getStaticPaths() {
    const { tags } = await getContent();
    return tags.flatMap((tag) =>
        uniquePathAliases(tag.id, tag.name).map((slug) => ({
            params: { slug },
            props: { tag }
        }))
    );
}

const { tag } = Astro.props;
const site = await getSite();
const { content, settings } = site;
const { config } = content;
const noun = config.items_name.toLowerCase();
const cards = sortedCards(site, content.items.filter((item) => itemHasTag(item, tag)));
const scoped = scopedTaxonomy(site, cards);
const path = `/tag/${tag.id}`;
const count = cards.length;
const description = `${count} ${count === 1 ? config.item_name.toLowerCase() : noun} tagged “${tag.name}”${count ? `: ${exampleNames(cards)}` : ''}. Browse and compare them on ${config.company_name}.`;
---

<BaseLayout
    title={`${tag.name} — ${count} ${count === 1 ? config.item_name : config.items_name}`}
    description={description}
    canonicalUrl={path}
    markdownMirrorUrl={`${path}.md`}
    noindex={count === 0}
    jsonLd={[
        collectionPageJsonLd(site, { name: `${tag.name} ${noun}`, description, path }, cards),
        breadcrumbJsonLd(site, [
            { name: 'Home', path: '/' },
            { name: 'Tags', path: '/tags' },
            { name: tag.name, path }
        ])
    ]}
>
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tags', href: '/tags' }, { label: `#${tag.name}` }]} />

    <section data-component="tag-page">
        <h1 data-part="heading">#{tag.name}</h1>
        <p data-part="count" style="color:var(--muted-foreground);margin-bottom:1.5rem">{count} {count === 1 ? config.item_name.toLowerCase() : noun}</p>

        <DirectoryBrowser
            items={cards}
            total={count}
            perPage={settings.itemsPerPage}
            categories={settings.sections.categories ? scoped.categories : []}
            tags={scoped.tags.filter((t) => t.id !== tag.id)}
            scopeTag={tag.id}
            basePath={path}
            itemsName={config.items_name}
            defaultSort={settings.homepage.defaultSort}
            searchEnabled={settings.homepage.searchEnabled}
            heading={`${tag.name} ${noun}`}
        />
    </section>
</BaseLayout>
