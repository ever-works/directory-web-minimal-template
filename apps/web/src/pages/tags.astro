---
/**
 * Tags Index — every used tag as a chip with its item count, most used first.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSite } from '../lib/site';
import { breadcrumbJsonLd } from '../lib/structured-data';
import Breadcrumbs from '@ever-works/ui/astro/Breadcrumbs.astro';
import EmptyState from '@ever-works/ui/astro/EmptyState.astro';

const site = await getSite();
const { config, tags } = site.content;
const used = tags.filter((t) => t.count > 0).sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
const description = `Browse ${config.company_name} by tag: ${used
    .slice(0, 8)
    .map((t) => t.name)
    .join(', ')}${used.length > 8 ? ` and ${used.length - 8} more` : ''}.`;
---

<BaseLayout
    title={`Tags — ${used.length} tags`}
    description={description}
    canonicalUrl="/tags"
    jsonLd={[breadcrumbJsonLd(site, [{ name: 'Home', path: '/' }, { name: 'Tags', path: '/tags' }])]}
>
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tags' }]} />

    <section data-component="tags-page">
        <h1 data-part="heading">Tags</h1>
        <p style="color:var(--muted-foreground);margin-bottom:1.5rem">{used.length} tags</p>
        {used.length === 0 ? (
            <EmptyState message="No tags defined." />
        ) : (
            <div class="dw-tag-cloud" data-component="tag-list" style="gap:0.5rem">
                {used.map((tag) => (
                    <a href={`/tag/${encodeURIComponent(tag.id)}`} class="dw-chip" style="font-size:0.875rem;padding:0.35rem 0.85rem" data-part="tag">
                        #{tag.name} <span class="dw-chip-count">{tag.count}</span>
                    </a>
                ))}
            </div>
        )}
    </section>
</BaseLayout>
