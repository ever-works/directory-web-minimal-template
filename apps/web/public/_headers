# Static response headers for Cloudflare Workers Static Assets / Pages and Netlify (ignored by other hosts).
# Long-lived caching for hashed assets, CORS on the agent-facing data, content types for extension-less
# discovery documents, baseline security headers. See .specify/features/agent-access.md.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/*
  Cache-Control: public, max-age=3600
/data/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, s-maxage=900
/llms.txt
  Access-Control-Allow-Origin: *
/llms-full.txt
  Access-Control-Allow-Origin: *
/items.json
  Access-Control-Allow-Origin: *
/feed.json
  Access-Control-Allow-Origin: *
/*.md
  Access-Control-Allow-Origin: *
  Content-Type: text/markdown; charset=utf-8
/.well-known/mcp.json
  Access-Control-Allow-Origin: *
/.well-known/api-catalog
  Access-Control-Allow-Origin: *
  Content-Type: application/linkset+json; charset=utf-8
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
