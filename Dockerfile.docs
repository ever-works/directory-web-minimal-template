# syntax=docker/dockerfile:1.7
# Static build for the Ever Works minimal-template DOCS app (Docusaurus), used by
# the ever-static-dev demo (docs.demo-minimal.ever.works). Produces a small nginx
# image serving apps/docs/build on :80.
#
# DOCS_BASE_URL='/' overrides the GitHub-Pages subpath baseUrl so the site serves
# correctly at host root on k8s (the nginx server block is provided by the
# nginx-static-serve ConfigMap, so the stock nginx:alpine :80 default is fine).

ARG NODE_VERSION=22-alpine
ARG NGINX_VERSION=1.27-alpine

# ---- builder ---------------------------------------------------------------

FROM node:${NODE_VERSION} AS builder
WORKDIR /work
RUN corepack enable && apk add --no-cache git libc6-compat

ARG VERDACCIO_REGISTRY=""
ENV DOCS_BASE_URL="/"
ENV NODE_OPTIONS="--max-old-space-size=4096"

COPY . .

# A bounded reachability probe (busybox wget against Verdaccio's /-/ping) guards the
# redirect (wget -T 3 caps network ops, the outer busybox timeout 5 caps total
# runtime): if the cache is down or unreachable from this builder, warn and keep
# the public registry instead of letting a Verdaccio outage fail the build.
RUN if [ -n "$VERDACCIO_REGISTRY" ]; then \
        if timeout 5 wget -q -T 3 -O /dev/null "${VERDACCIO_REGISTRY%/}/-/ping"; then \
            echo "registry=${VERDACCIO_REGISTRY}" >> /work/.npmrc && \
            { sed -i "s|https://registry.npmjs.org|${VERDACCIO_REGISTRY%/}|g" /work/pnpm-lock.yaml 2>/dev/null || true; }; \
        else \
            echo "WARNING: Verdaccio registry ${VERDACCIO_REGISTRY} unreachable within 3s; falling back to the public npm registry" >&2; \
        fi; \
    fi

RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter "@ever-works/docs-minimal..."

# Canonical origin of the docs (DOCS_URL in apps/docs/docusaurus.config.ts), passed by
# k8s-build.yml from the repository variable of the same name. Empty keeps the config's own
# default, so this is additive: it lets a deployment name its host without editing the config.
ARG DOCS_URL=""
ENV DOCS_URL=${DOCS_URL}
RUN pnpm --filter "@ever-works/docs-minimal" build

# ---- runner ----------------------------------------------------------------

FROM nginx:${NGINX_VERSION} AS runner
ARG GITHUB_REPOSITORY=""
ARG GITHUB_SHA=""
LABEL org.opencontainers.image.source="https://github.com/${GITHUB_REPOSITORY}"
LABEL org.opencontainers.image.revision="${GITHUB_SHA}"

COPY --from=builder /work/apps/docs/build /usr/share/nginx/html
# nginx issues its own 301 for a slash-less directory URL (/foo -> /foo/). TLS ends at the edge,
# so this server only ever sees http and an absolute Location came out as
# http://docs.demo-minimal.ever.works/foo/, which the edge then bounced back to https: two hops,
# the first a scheme downgrade, for every slash-less URL - including every URL crawlers indexed
# under the old slash-less canonicals. With absolute_redirect off the Location is relative
# (/foo/) and resolves against the URL the client requested. The server block itself is the
# nginx-static-serve ConfigMap, mounted over conf.d/default.conf alone (subPath), so this file
# next to it is still included at http level by the stock nginx.conf and that server inherits it.
RUN printf 'absolute_redirect off;\n' > /etc/nginx/conf.d/00-absolute-redirect.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
