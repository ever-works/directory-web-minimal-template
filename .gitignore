# Dependencies
node_modules/

# Build outputs
dist/
.astro/
build/
.turbo/
.next/

# Content (cloned at build/dev time)
.content/
# The four seeded samples track their whole `.content/`: the CI E2E suite
# (apps/web-e2e, one project per sample) and the Lighthouse audit render
# them without a DATA_REPOSITORY, so the seed is the sample's data and the
# tests are written against it (see each `.specify/features/sample-*.md`).
# sample-git is not seeded: it clones its data repo into `.content/` at build
# time, so its `.content/` stays ignored.
!apps/sample-basic/.content/
!apps/sample-events/.content/
!apps/sample-jobs/.content/
!apps/sample-real-estate/.content/

# Environment
.env
.env.local
.env.*.local

